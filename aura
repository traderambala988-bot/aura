        image: "https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=700&q=80",
        affiliateLink: "https://amazon.com?tag=youraffiliatetag-20"
      },
      {
        id: 7,
        title: "Electric Milk Frother & Handheld Matcha Whisk",
        category: "Kitchen Hacks",
        tag: "Morning Routine",
        badgeColor: "bg-teal-600",
        price: 14.99,
        originalPrice: 22.00,
        rating: 4.7,
        reviews: 12500,
        description: "Creates thick, velvety coffeehouse microfoam in under 15 seconds. High speed titanium motor with sleek tabletop stand included.",
        image: "https://images.unsplash.com/photo-1517256064527-09c73fc73e38?auto=format&fit=crop&w=700&q=80",
        affiliateLink: "https://amazon.com?tag=youraffiliatetag-20"
      },
      {
        id: 8,
        title: "Retro Vinyl Record Bluetooth Speaker with Visual Spin",
        category: "Lifestyle",
        tag: "Gift Idea",
        badgeColor: "bg-pink-600",
        price: 45.00,
        originalPrice: 65.00,
        rating: 4.8,
        reviews: 860,
        description: "Plays punchy hi-fi audio while miniature vinyl record physically spins on top. Includes built-in white noise ocean and rainfall sound modes.",
        image: "https://images.unsplash.com/photo-1545454675-3531b543be5d?auto=format&fit=crop&w=700&q=80",
        affiliateLink: "https://amazon.com?tag=youraffiliatetag-20"
      }
    ];

    const categories = ["All", "Smart Tech", "Home & Decor", "Kitchen Hacks", "Lifestyle"];
    let currentCategory = "All";
    let searchQuery = "";
    let currentSort = "popular";
    let savedItems = JSON.parse(localStorage.getItem("aurapicks_saved") || "[]");

    // Initialize application on load
    window.addEventListener("DOMContentLoaded", () => {
      document.getElementById("currentYear").textContent = new Date().getFullYear();
      renderCategoryPills();
      renderProducts();
      updateSavedBadge();

      // Scroll listener for back to top button
      window.addEventListener("scroll", () => {
        const topBtn = document.getElementById("backToTopBtn");
        if (window.scrollY > 400) {
          topBtn.classList.remove("hidden");
        } else {
          topBtn.classList.add("hidden");
        }
      });
    });

    // Render Filter Badges
    function renderCategoryPills() {
      const container = document.getElementById("categoryContainer");
      container.innerHTML = categories.map(cat => {
        const isActive = cat === currentCategory;
        return `
          <button 
            onclick="filterByCategory('${cat}')"
            class="px-4 py-2 rounded-full text-xs font-bold transition-all whitespace-nowrap ${
              isActive 
                ? 'bg-rose-600 text-white shadow-md shadow-rose-600/20' 
                : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200/80'
            }"
          >
            ${cat}
          </button>
        `;
      }).join("");
    }

    // Filter by Category
    function filterByCategory(category) {
      currentCategory = category;
      document.getElementById("currentCategoryTitle").textContent = category === "All" ? "All Viral Finds" : `${category} Picks`;
      renderCategoryPills();
      renderProducts();
    }

    // Search Handler
    function handleSearch(query) {
      searchQuery = query.toLowerCase().trim();
      // Keep mobile and desktop inputs synced
      document.getElementById("desktopSearchInput").value = query;
      document.getElementById("mobileSearchInput").value = query;
      renderProducts();
    }

    // Sort Handler
    function handleSort(criteria) {
      currentSort = criteria;
      renderProducts();
    }

    // Filter & Sort core logic
    function getFilteredProducts() {
      return products
        .filter(item => {
          const matchesCategory = (currentCategory === "All") || (item.category === currentCategory);
          const matchesSearch = item.title.toLowerCase().includes(searchQuery) || 
                                item.description.toLowerCase().includes(searchQuery) ||
                                item.category.toLowerCase().includes(searchQuery);
          return matchesCategory && matchesSearch;
        })
        .sort((a, b) => {
          if (currentSort === "rating") return b.rating - a.rating;
          if (currentSort === "price-low") return a.price - b.price;
          if (currentSort === "price-high") return b.price - a.price;
          return b.reviews - a.reviews; // Popular default
        });
    }

    // Render Grid
    function renderProducts() {
      const grid = document.getElementById("productGrid");
      const noResults = document.getElementById("noResultsState");
      const counter = document.getElementById("productCounter");
      
      const filtered = getFilteredProducts();
      counter.textContent = `${filtered.length} items`;

      if (filtered.length === 0) {
        grid.innerHTML = "";
        noResults.classList.remove("hidden");
        return;
      }

      noResults.classList.add("hidden");
      grid.innerHTML = filtered.map(item => {
        const isSaved = savedItems.includes(item.id);
        const discountPercent = Math.round(((item.originalPrice - item.price) / item.originalPrice) * 100);

        return `
          <div class="group bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-soft hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between">
            
            <!-- Product Media Card -->
            <div class="relative overflow-hidden bg-slate-100 pt-[100%] cursor-pointer" onclick="openQuickView(${item.id})">
              <img 
                src="${item.image}" 
                alt="${item.title}" 
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onerror="this.src='https://placehold.co/600x600/f8fafc/94a3b8?text=Product+Image'"
              >
              
              <!-- Tag Badge -->
              <span class="absolute top-3 left-3 ${item.badgeColor} text-white text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded-full shadow-sm">
                ${item.tag}
              </span>

              <!-- Discount pill -->
              <span class="absolute top-3 right-12 bg-white/95 text-emerald-700 text-[10px] font-bold px-2 py-0.5 rounded-full shadow-sm backdrop-blur-xs">
                -${discountPercent}%
              </span>

              <!-- Save Button -->
              <button 
                onclick="event.stopPropagation(); toggleSaveItem(${item.id})"
                class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 hover:bg-white text-slate-700 flex items-center justify-center shadow-md transition-all active:scale-90"
                title="${isSaved ? 'Remove from Saved' : 'Save for Later'}"
              >
                <i class="${isSaved ? 'fa-solid text-rose-500' : 'fa-regular text-slate-600'} fa-heart text-sm"></i>
              </button>

              <!-- Quick View Floating Button on Hover -->
              <div class="absolute inset-x-0 bottom-3 px-4 flex justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                <span class="bg-white/95 backdrop-blur-md text-slate-900 text-xs font-bold py-1.5 px-4 rounded-full shadow-lg flex items-center gap-1.5">
                  <i class="fa-solid fa-eye text-slate-500 text-xs"></i> Quick Look
                </span>
              </div>
            </div>

            <!-- Content Area -->
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <!-- Category & Star Rating -->
                <div class="flex items-center justify-between text-xs mb-2">
                  <span class="text-slate-400 font-semibold uppercase text-[10px] tracking-wider">${item.category}</span>
                  <div class="flex items-center gap-1 text-amber-500 font-bold">
                    <i class="fa-solid fa-star text-[11px]"></i>
                    <span>${item.rating}</span>
                    <span class="text-slate-400 text-[10px]">(${item.reviews > 1000 ? (item.reviews/1000).toFixed(1) + 'k' : item.reviews})</span>
                  </div>
                </div>

                <!-- Product Name -->
                <h3 
                  onclick="openQuickView(${item.id})"
                  class="font-bold text-slate-900 text-sm leading-snug hover:text-rose-600 transition-colors cursor-pointer line-clamp-2 mb-2"
                >
                  ${item.title}
                </h3>

                <!-- Benefit line -->
                <p class="text-xs text-slate-500 line-clamp-2 mb-4 leading-relaxed">
                  ${item.description}
                </p>
              </div>

              <!-- Price & CTA Button -->
              <div>
                <div class="flex items-baseline justify-between mb-3">
                  <div class="flex items-baseline gap-1.5">
                    <span class="text-lg font-black text-slate-900">$${item.price.toFixed(2)}</span>
                    <span class="text-xs text-slate-400 line-through">$${item.originalPrice.toFixed(2)}</span>
                  </div>
                  <span class="text-[10px] font-bold text-emerald-600 flex items-center gap-1">
                    <i class="fa-solid fa-truck-fast"></i> Prime Ready
                  </span>
                </div>

                <!-- High Conversion CTA -->
                <a 
                  href="${item.affiliateLink}" 
                  target="_blank" 
                  rel="nofollow sponsored noopener"
                  class="w-full py-2.5 px-4 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 active:scale-[0.98] text-slate-950 font-bold text-xs rounded-xl flex items-center justify-center gap-2 shadow-sm shadow-amber-500/20 transition-all"
                >
                  <i class="fa-brands fa-amazon text-sm"></i>
                  <span>Check Price on Amazon</span>
                </a>
              </div>

            </div>

          </div>
        `;
      }).join("");
    }

    // Reset filters
    function resetFilters() {
      currentCategory = "All";
      searchQuery = "";
      document.getElementById("desktopSearchInput").value = "";
      document.getElementById("mobileSearchInput").value = "";
      renderCategoryPills();
      renderProducts();
    }

    // Quick View Modal
    function openQuickView(id) {
      const item = products.find(p => p.id === id);
      if (!item) return;

      document.getElementById("modalImg").src = item.image;
      document.getElementById("modalTitle").textContent = item.title;
      document.getElementById("modalPrice").textContent = `$${item.price.toFixed(2)}`;
      document.getElementById("modalOriginalPrice").textContent = `$${item.originalPrice.toFixed(2)}`;
      document.getElementById("modalRating").textContent = item.rating;
      document.getElementById("modalReviews").textContent = `(${item.reviews.toLocaleString()} reviews)`;
      document.getElementById("modalDescription").textContent = item.description;
      document.getElementById("modalAffiliateLink").href = item.affiliateLink;
      document.getElementById("modalBadge").textContent = item.tag;

      document.getElementById("quickViewModal").classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeQuickView() {
      document.getElementById("quickViewModal").classList.add("hidden");
      document.body.style.overflow = "auto";
    }

    // Close modal when clicking outside box
    document.getElementById("quickViewModal").addEventListener("click", function(e) {
      if (e.target === this) {
        closeQuickView();
      }
    });

    // Wishlist / Save Items Feature
    function toggleSaveItem(id) {
      const index = savedItems.indexOf(id);
      if (index > -1) {
        savedItems.splice(index, 1);
        showToast("Removed from your saved items", "info");
      } else {
        savedItems.push(id);
        showToast("Saved to your wishlist! View anytime.", "success");
      }
      localStorage.setItem("aurapicks_saved", JSON.stringify(savedItems));
      updateSavedBadge();
      renderProducts();
      renderSavedDrawer();
    }

    function updateSavedBadge() {
      document.getElementById("savedCountBadge").textContent = savedItems.length;
    }

    function toggleSavedDrawer() {
      const drawer = document.getElementById("savedDrawer");
      const isHidden = drawer.classList.contains("hidden");
      if (isHidden) {
        renderSavedDrawer();
        drawer.classList.remove("hidden");
        document.body.style.overflow = "hidden";
      } else {
        drawer.classList.add("hidden");
        document.body.style.overflow = "auto";
      }
    }

    function renderSavedDrawer() {
      const listContainer = document.getElementById("savedListContainer");
      const savedProducts = products.filter(p => savedItems.includes(p.id));

      if (savedProducts.length === 0) {
        listContainer.innerHTML = `
          <div class="text-center py-12 text-slate-400">
            <i class="fa-regular fa-heart text-4xl mb-3 text-slate-300"></i>
            <p class="text-sm font-semibold text-slate-700">No saved finds yet</p>
            <p class="text-xs text-slate-400 mt-1">Tap the heart icon on any product to save it for later.</p>
          </div>
        `;
        return;
      }

      listContainer.innerHTML = savedProducts.map(item => `
        <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-2xl border border-slate-100">
          <img src="${item.image}" alt="${item.title}" class="w-14 h-14 object-cover rounded-xl">
          <div class="flex-1 min-w-0">
            <h4 class="text-xs font-bold text-slate-900 truncate">${item.title}</h4>
            <div class="text-xs font-black text-rose-600 mt-0.5">$${item.price.toFixed(2)}</div>
            <a 
              href="${item.affiliateLink}" 
              target="_blank" 
              rel="nofollow sponsored noopener" 
              class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-600 hover:text-amber-700 mt-1"
            >
              <span>View Deal</span>
              <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>
            </a>
          </div>
          <button onclick="toggleSaveItem(${item.id})" class="text-slate-400 hover:text-rose-500 p-2">
            <i class="fa-solid fa-trash-can text-xs"></i>
          </button>
        </div>
      `).join("");
    }

    function clearAllSaved() {
      savedItems = [];
      localStorage.setItem("aurapicks_saved", "[]");
      updateSavedBadge();
      renderProducts();
      renderSavedDrawer();
      showToast("Cleared all saved items", "info");
    }

    // Custom Toast Notification
    function showToast(msg, type = "success") {
      const toast = document.getElementById("toast");
      const toastMsg = document.getElementById("toastMessage");
      const toastIcon = document.getElementById("toastIcon");

      toastMsg.textContent = msg;
      if (type === "success") {
        toastIcon.className = "fa-solid fa-circle-check text-emerald-400 text-sm";
      } else {
        toastIcon.className = "fa-solid fa-circle-info text-sky-400 text-sm";
      }

      toast.classList.remove("hidden");
      setTimeout(() => {
        toast.classList.add("hidden");
      }, 3000);
    }

    // Share Page URL
    function sharePage() {
      if (navigator.share) {
        navigator.share({
          title: "AuraPicks — Viral Pinterest Curations",
          url: window.location.href
        }).catch(() => {});
      } else {
        // Fallback for iFrame restricted environments
        const dummy = document.createElement("input");
        document.body.appendChild(dummy);
        dummy.value = window.location.href;
        dummy.select();
        document.execCommand("copy");
        document.body.removeChild(dummy);
        showToast("Page link copied to clipboard!", "success");
      }
    }

    // Lead capture simulation
    function handleNewsletter(e) {
      e.preventDefault();
      showToast("Thank you! You'll receive this Friday's top 5 viral pins.", "success");
      e.target.reset();
    }
  </script>

</body>
</html>
